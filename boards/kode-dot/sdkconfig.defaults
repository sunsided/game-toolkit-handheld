# Kode Dot: ESP32-P4 rev v3, 32 MB HEX PSRAM at 250 MHz, 32 MB flash.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_BOOTLOADER_CACHE_32BIT_ADDR_QUAD_FLASH=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_CACHE_L2_CACHE_128KB=y
CONFIG_MMU_PAGE_SIZE_64KB=y
CONFIG_LCD_DSI_ISR_CACHE_SAFE=y
CONFIG_FREERTOS_HZ=1000
# Console: IDF default, UART0 primary (Wokwi reads it) + USB Serial/JTAG secondary (Kode Dot USB-C).

# Rust std needs a bigger main task than the C default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384
